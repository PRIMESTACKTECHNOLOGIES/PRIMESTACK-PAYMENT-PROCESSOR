# Payment Processor Configuration — EXAMPLE ONLY
# Copy this file to `.env` and fill in REAL values. Never commit `.env`.

PORT=6001

# Node environment: set to "production" on your host (Render/Railway/etc.)
NODE_ENV=production

# ── Stripe Integration ────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
# Use sk_test_... / pk_test_... for testing, sk_live_... / pk_live_... for production
STRIPE_SECRET_KEY=sk_test_replace_me

STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Your public HTTPS domain — required for 3DS redirects and Stripe webhooks
# Must be HTTPS in production (e.g. https://yourdomain.com)
STRIPE_RETURN_URL=https://yourdomain.com

# Stripe Webhook Secret — get this from https://dashboard.stripe.com/webhooks
# After adding an endpoint for /api/webhooks/stripe, copy the signing secret here
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ── Admin credentials ─────────────────────────────────────────────────────────
# Admin password/API key — set a strong random value (32+ chars).
# Example: openssl rand -hex 32
ADMIN_API_KEY=change_me_to_a_strong_random_value

# Base32 TOTP secret. When set, admin MFA (step-up) is ENFORCED on sensitive
# operations (credential changes, key rotation). Generate with:
#   node -e "console.log(require('./utils/authService').generateMFASecret())"
ADMIN_MFA_SECRET=change_me_to_a_long_random_value

# ── Encryption ────────────────────────────────────────────────────────────────
# Encryption key for the secure vault — 32 bytes hex (64 hex chars).
# Example: openssl rand -hex 32
ENCRYPTION_KEY=change_me_to_a_long_random_value



# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. REQUIRED in production.
# In production, requests from origins not listed here are rejected.
# Example: https://portal.yourdomain.com,https://admin.yourdomain.com
CORS_ORIGINS=

# ── Storage ───────────────────────────────────────────────────────────────────
# Directory for the SQLite database. MUST point to a PERSISTENT disk in
# production (e.g. a Render disk mount). Leave blank to use ./data.
# Serverless platforms (Netlify/Vercel/Lambda) fall back to ephemeral /tmp and
# will NOT persist data — use an external database there.
DATA_DIR=

# ── Simulation gating ─────────────────────────────────────────────────────────
# Simulated payment paths (mock acquirer / GPU / ISO8583) are disabled whenever
# NODE_ENV=production. Set to "true" ONLY to explicitly re-enable them (never in
# a real production deployment).
ALLOW_SIMULATION=false

# ── Auth lockout ──────────────────────────────────────────────────────────────
# Failed API-key attempts before the client is temporarily locked out.
AUTH_LOCKOUT_THRESHOLD=5
# Lockout duration in milliseconds (default 15 minutes).
AUTH_LOCKOUT_DURATION_MS=900000

# ── Database (optional) ───────────────────────────────────────────────────────
# SQLite is used by default. PostgreSQL recommended for production.
# DATABASE_URL=postgresql://user:password@localhost:5432/payment_processor
